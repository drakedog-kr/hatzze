# FRED. 원/달러 환율(DEXKOUS)만 받는다. 배당 화면의 원/달러가 ECB 에서 안 올 때 쓰는 예비다(common/fx.py)
FRED_API_KEY=

# NAVER API HUB (네이버 클라우드) — 검색어트렌드 + 뉴스 검색
# 콘솔에서 Application 하나에 'NAVER 검색 > 뉴스'와 'Data Lab > 검색어트렌드'를
# 함께 등록하면 아래 키 한 쌍으로 둘 다 호출된다. (구 개발자센터 키는 2026-07-22 폐기)
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=

# KRX Open API (코스피 시세, 신고가 괴리율, 버핏지수 시총)
KRX_API_KEY=

# 한국은행 ECOS (버핏지수 GDP)
ECOS_API_KEY=

# 핀허브 시세(무료 플랜, 분당 60회). 국장 미리보기의 미국 종목 간밤 등락과 미국 배당주·ETF 시세에 쓴다.
# 배당 엔드포인트는 무료 플랜에서 막혀 있어(403) 배당 자체는 SEC 에서 받는다
FINNHUB_API_KEY=

# 한국예탁결제원(공공데이터포털 금융위원회). 국내 배당 기록(배당으로 살기)과 외화증권 결제를 받는다.
# 공공데이터포털 계정으로 활용 신청을 하면 발급된다.
KSD_API_KEY=

# 알라딘 오픈API (경제·재테크 도서 베스트셀러 비중)
ALADIN_TTB_KEY=

# YouTube Data API (인기 급상승 동영상 중 경제 콘텐츠 비중)
YOUTUBE_API_KEY=

# 공공데이터포털 - 기상청 ASOS 일자료 (서울 맑은 날씨 지수)
KMA_API_KEY=

# GitHub 검색 API (트레이딩봇 저장소 생성 수) - 선택, 없으면 비인증으로 호출됨(rate limit만 낮아짐)
GITHUB_TOKEN=

# Anthropic (오늘의 요약 · 카더라 총평 · 테마 요약 · 채널 글). 아래 구독 토큰이 있으면 그쪽이 먼저고,
# 구독이 막힐 때 이 키로 다시 부른다. 둘 다 없으면 LLM 스텝만 건너뜀
ANTHROPIC_API_KEY=

# Claude Code 구독 토큰 (선택). `claude setup-token` 으로 발급한다. 있으면 LLM 호출을 구독(claude -p)으로
# 먼저 보내고, 실패하면 ANTHROPIC_API_KEY 로 되돌린다(common/llm_client.py). 절대 커밋 금지
CLAUDE_CODE_OAUTH_TOKEN=

# Telegram (카더라 리포트 - 채널 메시지 수집). my.telegram.org에서 발급 후
# scripts/generate_telegram_session.py로 세션 1회 생성. 세션은 절대 커밋 금지
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# 모니터링 채널 목록 구글시트 ID (카더라 리포트)
TELEGRAM_CHANNELS_SHEET_ID=

# 텔레그램 채널 발송 (매일 오늘의 지수 브로드캐스트) - 위 수집용 값과 별개다.
# @BotFather 로 봇을 만들어 받은 토큰과, 봇을 관리자로 넣은 채널의 chat_id.
# chat_id 는 공개 채널이면 핸들 그대로(@내채널핸들), 비공개면 -100 으로 시작하는 숫자.
# 없으면 발송 스크립트가 중단만 하고 나머지 파이프라인엔 영향이 없다. 절대 커밋 금지
TELEGRAM_BOT_TOKEN=
TELEGRAM_BROADCAST_CHAT_ID=

# 검색엔진 소유확인 (선택 - 없으면 메타 태그를 안 넣는다)
# 구글 서치콘솔: 'HTML 태그' 방식의 content 값만 넣는다
# 네이버 서치어드바이저: 'HTML 태그' 방식의 content 값만 넣는다
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Google Analytics 4 측정 ID (선택 - 없으면 gtag 스크립트를 아예 안 넣는다).
# 클라이언트에 그대로 노출되는 공개값이라 NEXT_PUBLIC_ 을 붙인다.
# 로컬에 채워두면 개발 중 방문도 프로덕션 통계에 잡히니 검증할 때만 켠다.
NEXT_PUBLIC_GA_ID=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 종목 로고 (선택 - 없으면 이름 첫 글자 배지로 그린다).
# logo.dev 무료 플랜의 publishable key. 서버 라우트(/api/logo)만 읽고 클라이언트 번들에는
# 안 실린다. 이름은 LOGO_DEV_KEY 가 먼저고, 처음에 이미지 URL 에 그대로 실었던 흔적인
# NEXT_PUBLIC_LOGO_DEV_KEY 도 그대로 읽는다(둘 중 하나만 두면 된다. Vercel 에서
# NEXT_PUBLIC_ 이름을 Sensitive 로 두면 접두어 경고가 뜨는데, 그때는 새 이름으로 옮기면 된다).
# 무료 한도(월 50만 요청)를 넘기면 다음 달 1일까지 전부 429 라 배지로 나온다
# (2026-09-17 에 겪었다) — 캐시 정책은 lib/stock-logo.ts.
# 티커는 거래소 접미사가 맞아야 한다 — KOSPI=.KS / KOSDAQ=.KQ. 틀리면 에러가 아니라
# 조용히 엉뚱한 폴백 이미지가 온다.
LOGO_DEV_KEY=

# 화면 사본(ISR)을 비우는 /api/revalidate 의 비밀. 파이프라인(.github/workflows/daily-update.yml)이
# 끝나면서 같은 값을 Bearer 로 보낸다 — 깃헙 시크릿 REVALIDATE_SECRET 과 같아야 한다.
# 비어 있으면 라우트는 503 을 돌려주고 아무것도 안 하며, 화면은 한 시간(카더라 30분) 안에 스스로 새로 그린다.
REVALIDATE_SECRET=

# 예약 실행 (Vercel 에만 둔다). Vercel Cron 이 /api/cron/pipeline 을 부르면 그 라우트가 깃헙에
# workflow_dispatch 를 던진다(vercel.json 의 crons · lib/cron-schedule.ts).
# CRON_SECRET 은 Vercel 이 크론 호출에 Bearer 로 붙여 보내는 값이라, 없으면 라우트가 401 로 전부 거절한다.
# GH_DISPATCH_TOKEN 은 이 저장소의 Actions 읽기·쓰기 권한이 있는 깃헙 토큰(실행 목록 조회 + 던지기). 절대 커밋 금지
CRON_SECRET=
GH_DISPATCH_TOKEN=
