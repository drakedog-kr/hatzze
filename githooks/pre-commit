#!/bin/sh
# 워킹트리 하나를 여러 세션이 공유해서 생기는 두 가지 사고를 커밋 직전에 막는다.
# 배경은 AGENTS.md. 정말 필요하면 `git commit --no-verify` 로 넘어갈 수 있다.
#
# .git/hooks 는 연결된 워크트리 전부가 공유하므로 이 파일 하나가 모든 세션에 걸린다.

branch=$(git symbolic-ref --short -q HEAD)

# 1) main 에 직접 커밋. 2026-07-29 에 남의 체크아웃에 얹혀 실제로 벌어졌다.
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
	cat >&2 <<-'MSG'

		✋ main 에 직접 커밋하려 합니다.
		   브랜치부터 파십시오:  git switch -c <브랜치>
		   (그래도 진행하려면  git commit --no-verify)

	MSG
	exit 1
fi

# 2) 이미 머지됐고 뒤처진 브랜치 위에서 커밋. 이 상태의 수정분은 '새 작업'이 아니라
#    '되돌리기'다 — 2026-07-31 에 22파일 766줄이 되돌아갈 뻔했다.
#
#    자기 커밋이 하나라도 있으면 origin/main 의 조상이 아니게 되므로 여기 안 걸린다.
#    걸리는 건 '남의 커밋만 있는데 뒤처진' 상태뿐이라, 브랜치를 다시 따면 잃을 게 없다.
if git rev-parse --verify -q origin/main >/dev/null 2>&1 &&
	git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
	behind=$(git rev-list --count HEAD..origin/main)
	if [ "$behind" -gt 0 ]; then
		cat >&2 <<-MSG

			✋ 지금 HEAD(${branch:-detached})는 이미 origin/main 에 들어가 있고 ${behind}커밋 뒤처져 있습니다.
			   이대로 커밋하면 새 작업이 아니라 머지된 작업을 되돌립니다.

			   확인:  git diff --stat origin/main      (삭제 줄이 크면 확정)
			   해결:  git fetch origin && git switch -c <새 브랜치> origin/main
			   (그래도 진행하려면  git commit --no-verify)

		MSG
		exit 1
	fi
fi

exit 0
